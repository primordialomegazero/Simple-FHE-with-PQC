FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ninja-build g++ ca-certificates \
    libssl-dev libjsoncpp-dev uuid-dev zlib1g-dev \
    libpq-dev libmariadb-dev curl && rm -rf /var/lib/apt/lists/* && \
    update-ca-certificates

ENV GIT_SSL_NO_VERIFY=1

# Build Drogon from source
RUN git clone --depth 1 --branch v1.9.13 https://github.com/drogonframework/drogon.git /tmp/drogon \
    && cd /tmp/drogon && git submodule update --init \
    && mkdir build && cd build \
    && cmake -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=ON .. \
    && make -j$(nproc) && make install && rm -rf /tmp/drogon

# Build liboqs
RUN git clone --depth 1 --branch 0.10.0 https://github.com/open-quantum-safe/liboqs.git /tmp/liboqs \
    && cd /tmp/liboqs && mkdir build && cd build \
    && cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=ON .. \
    && ninja && ninja install && rm -rf /tmp/liboqs

# Build SEAL
RUN git clone --depth 1 --branch v4.1.1 https://github.com/microsoft/SEAL.git /tmp/SEAL \
    && cd /tmp/SEAL && cmake -S . -B build -DSEAL_USE_MSGSL=OFF -DBUILD_SHARED_LIBS=ON \
    && cmake --build build -j$(nproc) && cmake --install build && rm -rf /tmp/SEAL

# Build OpenFHE
RUN git clone --depth 1 --branch v1.2.0 https://github.com/openfheorg/openfhe-development.git /tmp/openfhe \
    && cd /tmp/openfhe && cmake -S . -B build -DBUILD_SHARED_LIBS=ON \
    && cmake --build build -j$(nproc) && cmake --install build && rm -rf /tmp/openfhe

# Build dost-fhe
COPY src/ /app/src/
COPY CMakeLists.txt /app/
WORKDIR /app/build
RUN cmake .. -DCMAKE_BUILD_TYPE=Release && make -j$(nproc)

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libjsoncpp25 libpq5 libmariadb3 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/lib/libdrogon.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libtrantor.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/liboqs.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libseal.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libOPENFHE*.so* /usr/local/lib/
RUN ldconfig
COPY --from=builder /app/build/dost-fhe /app/
COPY test_suite.sh /app/
WORKDIR /app
RUN groupadd -r dost && useradd -r -g dost dost && chown -R dost:dost /app
USER dost
EXPOSE 8086
ENV LD_LIBRARY_PATH=/usr/local/lib
ENTRYPOINT ["./dost-fhe"]
